SERVER_HOST=127.0.0.1
SERVER_PORT=3434
FRONTEND_URL=http://your-domain.com

DATA_DIR=./data
SQLITE_DB_PATH=./data/novelhub.db

# IMPORTANT: Generate strong random secrets before deploying!
# Example: openssl rand -hex 32
JWT_SECRET=your-secret-key
JWT_REFRESH_SECRET=your-secret-key
DB_ENCRYPTION_KEY=your-secret-key
TOKEN_VERSION_CACHE=true
SQLITE_CACHE_SIZE_KB=262144
SQLITE_MMAP_SIZE_BYTES=536870912
COOKIE_SECURE=false
COOKIE_DOMAIN=

DISABLE_REQUEST_LOG=true
DISABLE_RESPONSE_COMPRESSION=false
ENABLE_PREFORK=false
DISABLE_STARTUP_MESSAGE=false

LOG_MAX_SIZE_MB=10
LOG_MAX_FILES=5
RESTORE_AUTO_RESTART=false
